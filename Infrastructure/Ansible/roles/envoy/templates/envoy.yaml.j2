static_resources:
  listeners:
    - name: listener_http
      address:
        socket_address:
          address: 0.0.0.0
          port_value: {{ envoy_listen_port }}
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: ingress_http
                codec_type: AUTO
                route_config:
                  name: local_route
                  virtual_hosts:
                    - name: edge_apps
                      domains: ["*"]
                      routes:
                        - match:
                            prefix: "/sonarqube"
                          route:
                            cluster: sonarqube_cluster
                        - match:
                            prefix: "/gitlab"
                          route:
                            cluster: gitlab_cluster
                        - match:
                            prefix: "/"
                          redirect:
                            path_redirect: "/gitlab/"
                http_filters:
                  - name: envoy.filters.http.wasm
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.wasm.v3.Wasm
                      config:
                        name: "{{ envoy_wasm_filter_name }}"
                        root_id: ""
                        vm_config:
                          vm_id: "{{ envoy_wasm_vm_id }}"
                          runtime: envoy.wasm.runtime.v8
                          code:
                            local:
                              filename: "{{ envoy_wasm_path }}"
                        configuration:
                          "@type": type.googleapis.com/google.protobuf.StringValue
                          value: |
                            {
                              "directives_map": {
                                "default": [
                                  "Include @demo-conf",
                                  "SecDebugLogLevel 9",
                                  "SecRuleEngine On",
                                  "Include @crs-setup-conf",
                                  "Include @owasp_crs/*.conf"
                                ]
                              },
                              "default_directives": "default"
                            }
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
  clusters:
    - name: gitlab_cluster
      connect_timeout: 2s
      type: STATIC
      load_assignment:
        cluster_name: gitlab_cluster
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: {{ envoy_upstream_host }}
                      port_value: {{ envoy_upstream_port }}
    - name: sonarqube_cluster
      connect_timeout: 2s
      type: STATIC
      load_assignment:
        cluster_name: sonarqube_cluster
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: {{ envoy_sonarqube_upstream_host }}
                      port_value: {{ envoy_sonarqube_upstream_port }}
admin:
  access_log_path: /tmp/admin_access.log
  address:
    socket_address:
      address: 127.0.0.1
      port_value: {{ envoy_admin_port }}
