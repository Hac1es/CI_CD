all:
  vars:
    ansible_user: ${oslogin_username}
    ansible_ssh_private_key_file: "/home/tung/.ssh/google_compute_engine"
    ansible_ssh_common_args: "-o IdentitiesOnly=yes -o StrictHostKeyChecking=no"
    ansible_python_interpreter: /usr/bin/python3.10

  children:
    edge:
      hosts:
        proxy_bastion:
          ansible_host: ${bastion_public_ip}

    management:
      vars:
        ansible_ssh_common_args: >-
          -o ProxyCommand="ssh -i /home/tung/.ssh/google_compute_engine
          -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -W %h:%p
          ${oslogin_username}@${bastion_public_ip}"
      hosts:
        jenkins:
          ansible_host: ${jenkins_private_ip}
        harbor:
          ansible_host: ${harbor_private_ip}

    workload:
      vars:
        ansible_ssh_common_args: >-
          -o ProxyCommand="ssh -i /home/tung/.ssh/google_compute_engine
          -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -W %h:%p
          ${oslogin_username}@${bastion_public_ip}"
      hosts:
        k3s_master:
          ansible_host: ${k3s_master_private_ip}
        k3s_worker:
          ansible_host: ${k3s_worker_private_ip}
